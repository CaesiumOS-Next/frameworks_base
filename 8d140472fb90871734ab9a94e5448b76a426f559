      },
      "writtenOn": "2023-10-10T16:28:31Z",
      "side": 1,
      "message": "Let\u0027s not guard this with this permission. Instead, let\u0027s just return the set of packages that are visible to the user.",
      "range": {
        "startLine": 170,
        "startChar": 0,
        "endLine": 170,
        "endChar": 71
      },
      "revId": "8d140472fb90871734ab9a94e5448b76a426f559",
