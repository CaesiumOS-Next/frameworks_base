    {
      "key": {
        "uuid": "AAAAx3///uQ\u003d",
        "filename": "core/java/android/widget/AbsListView.java",
        "patchSetId": 1
      },
      "lineNbr": 571,
      "author": {
        "id": 1003716
      },
      "writtenOn": "2010-04-28T08:57:47Z",
      "side": 1,
      "message": "We ran into problems with this since we need the TypedArray (a) when fetching the resources. If the things here are set only if enabledFastScroll \u003d\u003d true, then it won\u0027t be possible to switch on the fast scroller after the list has been created (that is probably a very rare use case, but there _is_ a public setFastScrollEnabled).\n\nThe best solution would be to move this into setFastScrollEnabled, but there we haven\u0027t got access to the TypedArray so we can\u0027t fetch the resources. Any suggestions on how to do this is very welcome.\n\nBTW, this is why we only get the resource id\u0027s, that should be less expensive than getting the drawables.",
      "parentUuid": "AAAAx3///44\u003d",
      "revId": "d377bfafddc95284ff5f9fbc1857513f5967efa0",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
      "unresolved": false
    },
