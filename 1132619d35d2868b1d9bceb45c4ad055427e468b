      },
      "writtenOn": "2024-02-13T00:30:43Z",
      "side": 1,
      "message": "I think this is kind of a convenience functionality that can be best handled in a support library.",
      "parentUuid": "2d5772e0_d0d5199b",
      "range": {
        "startLine": 5061,
        "startChar": 0,
        "endLine": 5061,
        "endChar": 4
