      "writtenOn": "2024-04-06T00:21:01Z",
      "side": 1,
      "message": "we may also want to re-use a single buffer for this, so we don\u0027t need repeated allocations.",
      "range": {
        "startLine": 86,
        "startChar": 0,
        "endLine": 86,
        "endChar": 46
      },
      "revId": "d2a001a4762d18144ec6c9a743c3d26bb77b9638",
