      },
      "lineNbr": 86,
      "author": {
        "id": 1120458
      },
      "writtenOn": "2024-04-06T00:30:12Z",
      "side": 1,
      "message": "do we know the maximum possible size of this? If it\u0027s like a 100MB APK with all 0s, I wonder if we could run out of memory and should read it in chunks?",
      "range": {
        "startLine": 86,
        "startChar": 36,
        "endLine": 86,
        "endChar": 44
      },
      "revId": "d2a001a4762d18144ec6c9a743c3d26bb77b9638",
