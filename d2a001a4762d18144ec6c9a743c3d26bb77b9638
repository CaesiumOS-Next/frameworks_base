      "writtenOn": "2024-04-05T23:54:49Z",
      "side": 1,
      "message": "oh also - we should use memcmp here - it will be much much faster",
      "range": {
        "startLine": 93,
        "startChar": 22,
        "endLine": 93,
        "endChar": 98
      },
      "revId": "d2a001a4762d18144ec6c9a743c3d26bb77b9638",
