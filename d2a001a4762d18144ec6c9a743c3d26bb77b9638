        "id": 1120458
      },
      "writtenOn": "2024-04-09T22:08:34Z",
      "side": 1,
      "message": "It will be repeated I/O - the same I/O cost, whether it happens in a single  ReadFullyAtOffset call or another.\n\nStill, it would be better to re-use the buffer.",
      "parentUuid": "3ca80d90_34b019f5",
      "range": {
        "startLine": 86,
        "startChar": 36,
        "endLine": 86,
        "endChar": 44
      },
      "revId": "d2a001a4762d18144ec6c9a743c3d26bb77b9638",
