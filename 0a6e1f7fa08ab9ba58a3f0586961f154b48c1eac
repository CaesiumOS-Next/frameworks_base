      "message": "Hi diyab@google.com jbolinger@google.com\n\nThe `ConcurrentHashMap` does not have a `contains` method, so it was changed to `containsKey`",
      "range": {
        "startLine": 58,
        "startChar": 8,
        "endLine": 58,
        "endChar": 49
      },
      "revId": "0a6e1f7fa08ab9ba58a3f0586961f154b48c1eac",
