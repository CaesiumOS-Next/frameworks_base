      },
      "lineNbr": 69,
      "author": {
        "id": 1056478
      },
      "writtenOn": "2017-04-26T22:52:38Z",
      "side": 1,
      "message": "This is just to cleanup a specified list of temp files, right? \nMight make more sense to just say\nThe MBMS middleware sends this when it wishes to cleanup temporary files in the app\u0027s filesystem.",
      "range": {
        "startLine": 68,
        "startChar": 87,
        "endLine": 69,
        "endChar": 36
      },
      "revId": "8de31ce9792f7d596eeff7eb8ae7e47f66988309",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
      "unresolved": false
    },
    {
