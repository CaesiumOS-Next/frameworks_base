        "id": 1056478
      },
      "writtenOn": "2017-04-26T22:52:38Z",
      "side": 1,
      "message": "EXTRA_REQUEST is for the result code of a download; is this required here?",
      "range": {
        "startLine": 56,
        "startChar": 7,
        "endLine": 56,
        "endChar": 29
      },
      "revId": "8de31ce9792f7d596eeff7eb8ae7e47f66988309",
