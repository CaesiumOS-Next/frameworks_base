<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Some operators redirect the call barring MMI code to other purpose.
         The MMI code of this array is not processed for call barring service
         SC_BAOs       "33"
         SC_BAOIC      "331"
         SC_BAOICxH    "332"
         SC_BAIC       "35"
         SC_BAICr      "351"
         SC_BA_ALL     "330"
         SC_BA_MO      "333"
         SC_BA_MT      "353"
         -->
    <string-array translatable="false" name="config_redirectedCallBarringMMI">
        <item>333</item>
    </string-array>
</resources>
