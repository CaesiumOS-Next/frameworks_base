    {
      "key": {
        "uuid": "775f0106_9d1bd634",
        "filename": "services/core/java/com/android/server/connectivity/NetworkMonitor.java",
        "patchSetId": 15
      },
      "lineNbr": 817,
      "author": {
        "id": 1000451
      },
      "writtenOn": "2018-04-05T06:41:52Z",
      "side": 1,
      "message": "We need to process it in ValidatedState when, for example, we\u0027re already validated and the user changes the hostname in settings.\n\nIt\u0027s now only handled in ValidatedState and here.",
      "parentUuid": "0c0151fb_ca8734c0",
      "range": {
