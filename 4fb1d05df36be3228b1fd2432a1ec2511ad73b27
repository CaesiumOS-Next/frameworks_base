      "writtenOn": "2018-04-05T05:49:28Z",
      "side": 1,
      "message": "Can we achieve the same result by ensuring that only EvaluatingPrivateDnsState will ever process this message?",
      "range": {
        "startLine": 814,
        "startChar": 0,
        "endLine": 817,
        "endChar": 53
