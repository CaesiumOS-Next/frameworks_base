    {
      "key": {
        "uuid": "82ff7f08_2fb576fc",
        "filename": "services/core/java/com/android/server/connectivity/NetworkMonitor.java",
        "patchSetId": 15
      },
      "lineNbr": 854,
      "author": {
        "id": 1000835
      },
      "writtenOn": "2018-04-05T05:49:28Z",
      "side": 1,
      "message": "If when we get to this state the network is a captive portal, then no amount of waiting will result in a successful probe. Should we limit the number of attempts we make, and after that, go back into EvaluatingState?",
      "range": {
        "startLine": 852,
        "startChar": 0,
        "endLine": 854,
        "endChar": 13
      },
      "revId": "4fb1d05df36be3228b1fd2432a1ec2511ad73b27",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
      "unresolved": true
    },
    {
      "key": {
        "uuid": "b4648b69_9c37df48",
        "filename": "services/core/java/com/android/server/connectivity/NetworkMonitor.java",
        "patchSetId": 15
      },
      "lineNbr": 854,
      "author": {
        "id": 1000451
      },
      "writtenOn": "2018-04-05T06:41:52Z",
      "side": 1,
      "message": "I was relying on an app calling reportBadNetwork to send a message the moves us over to Evaluating.\n\nIf some enters \"bogus.example.com\" it seems like the smallest amount of traffic we can generate would be the occasional re-resolve.\n\nIf someone enters \"www.google.com\", the smallest traffic we can enter would be the occasional TLS re-connection.",
      "parentUuid": "82ff7f08_2fb576fc",
