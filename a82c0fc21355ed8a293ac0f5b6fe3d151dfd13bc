        "patchSetId": 9
      },
      "lineNbr": 25,
      "author": {
        "id": 1135723
      },
      "writtenOn": "2017-12-07T21:27:27Z",
      "side": 1,
      "message": "Is this in upward or downward path? Do we have an existing equivalent Api currently for this?\nWhat values can result have?",
      "range": {
        "startLine": 25,
        "startChar": 9,
        "endLine": 25,
        "endChar": 31
      },
      "revId": "a82c0fc21355ed8a293ac0f5b6fe3d151dfd13bc",
