      },
      "lineNbr": 204,
      "author": {
        "id": 1060151
      },
      "writtenOn": "2017-12-13T20:43:15Z",
      "side": 1,
      "message": "Should the callback be registered as part of initialize()? Is it valid to initialize without one?",
      "range": {
        "startLine": 203,
        "startChar": 8,
        "endLine": 204,
        "endChar": 41
      },
      "revId": "8794dc069e6a1a5a8b5f2f364012c414bd11b556",
