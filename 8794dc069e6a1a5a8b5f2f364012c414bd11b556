      },
      "lineNbr": 161,
      "author": {
        "id": 1098053
      },
      "writtenOn": "2017-12-13T23:42:50Z",
      "side": 1,
      "message": "These are out of date, they should be called get/SetConfig (they deal with more than provisioning).\n\nWe need them for now for propagating user settings, such as Voice over LTE/IWLAN preferences and roaming settings.",
      "parentUuid": "0542f1eb_c5602b52",
      "range": {
        "startLine": 159,
        "startChar": 4,
        "endLine": 161,
        "endChar": 5
      },
      "revId": "8794dc069e6a1a5a8b5f2f364012c414bd11b556",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
      "unresolved": false
    },
    {
      "key": {
        "uuid": "787b1dce_dd68dd02",
