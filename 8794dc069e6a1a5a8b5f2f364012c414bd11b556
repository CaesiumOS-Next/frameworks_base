      "lineNbr": 238,
      "author": {
        "id": 1060151
      },
      "writtenOn": "2017-12-13T20:43:15Z",
      "side": 1,
      "message": "suggest this would look more straightforward as ImsFeature.remove(). Question about symmetry with the above Initialize() + add callback (where here we remove the callback and then remove()).",
      "range": {
        "startLine": 238,
        "startChar": 12,
        "endLine": 238,
        "endChar": 33
      },
      "revId": "8794dc069e6a1a5a8b5f2f364012c414bd11b556",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
      "unresolved": false
