    {
      "key": {
        "uuid": "3e49f96a_0634ca61",
        "filename": "telephony/java/android/telephony/ims/internal/ImsService.java",
        "patchSetId": 11
      },
      "lineNbr": 204,
      "author": {
        "id": 1098053
      },
      "writtenOn": "2017-12-13T23:42:50Z",
      "side": 1,
      "message": "I like them as separate functions because addImsFeatureStatusCallback has another function removeImsFeatureStatusCallback, which must be called here.  The add method also calls back to the framework with the current status, which may not be obvious if it is embedded in the init function.\n\nI switched the order of these two in setup",
      "parentUuid": "135ff87c_3ea5b87d",
      "range": {
        "startLine": 203,
        "startChar": 8,
        "endLine": 204,
        "endChar": 41
      },
      "revId": "8794dc069e6a1a5a8b5f2f364012c414bd11b556",
