    {
      "key": {
        "uuid": "fcdd64aa_9d842177",
        "filename": "services/tests/servicestests/src/com/android/server/compat/CompatConfigTest.java",
        "patchSetId": 4
      },
      "lineNbr": 285,
      "author": {
        "id": 1431994
      },
      "writtenOn": "2019-12-18T17:13:33Z",
      "side": 1,
      "message": "The purpose of this builder was to use a similar construct in both PlatformCompat (where you can only specify a _list_ of changes) and CompatConfig (where you can send individual changes). Removed all uses of OverridesBuilder in CompatConfigTest, renamed it to CompatibilityChangeConfigBuilder, made it a proper builder, use it only in PlatformCompatTest.",
      "parentUuid": "22ea3572_2a1e6b88",
      "range": {
        "startLine": 285,
        "startChar": 17,
        "endLine": 285,
        "endChar": 25
      },
      "revId": "9fb982b9091e9b3806a5edfad90b25402fba4bf1",
